<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\dist\Jatayu\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jatayu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core & Utilities -->
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Collections" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Concurrency" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Interop" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Localization" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Maths" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Memory" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Strings" Version="2026.10.2" />

    <!-- Windowing & Input -->
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Image" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Mixer" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Ttf" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.NativeFileDialog" Version="2026.10.3" />

    <!-- Graphics & Rendering -->
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Slang" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Render.Common" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Render.Mesh" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Render.Debug" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.RenderDoc" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.RenderDoc.ImGui" Version="2026.10.3" />

    <!-- Assets, Textures & Formats -->
    <PackageReference Include="Ahwoo.BRUTAL.Texture" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Texture.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Stb" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Gli" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Ktx" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.MeshOptimizer" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.FreeType" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ZLib" Version="2026.10.2" />

    <!-- UI -->
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Extensions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.FreeType" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImPlot" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.NotCurses" Version="2026.10.1" />

    <!-- Physics -->
    <PackageReference Include="Ahwoo.BRUTAL.Jolt" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Box2D" Version="2026.10.2" />

    <!-- Audio -->
    <PackageReference Include="Ahwoo.BRUTAL.OpenAl" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Fmod" Version="2026.10.4" />

    <!-- Networking & Monitoring -->
    <PackageReference Include="Ahwoo.BRUTAL.RakNet" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Monitor.Common" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Monitor.Host" Version="2026.10.3" />
    <PackageReference Include="Arch" Version="1.2.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="src\Jatayu.AssetFormats\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Jatayu.AssetFormats\Jatayu.AssetFormats.csproj" />
  </ItemGroup>

  <!-- Debug configuration: Copy GLSL source shaders for fast iteration/hot-reloading -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="assets\shaders\**\*.vert;assets\shaders\**\*.frag;assets\shaders\**\*.comp;assets\shaders\**\*.glsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="assets\textures\**\*.jtex" Condition="Exists('assets\textures')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="assets\generated\world.jpak" Condition="Exists('assets\generated\world.jpak')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Release configuration: Copy ONLY pre-compiled SPIR-V binaries and production .jpak containers -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="assets\generated\world.jpak" Condition="Exists('assets\generated\world.jpak')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>assets\packages\world.jpak</Link>
      <TargetPath>assets\packages\world.jpak</TargetPath>
    </None>
  </ItemGroup>

  <!-- Always exclude loose shader caches and intermediate cooker generator files from all builds -->
  <ItemGroup>
    <None Remove="assets\shaders\cache\**" />
    <None Remove="assets\generated\cells\**" />
    <None Remove="assets\generated\models\**" />
    <None Remove="assets\generated\cooked\**" />
  </ItemGroup>

  <!-- Publish shaders outside the source tree; Release runtime resolves SPIR-V beside the executable. -->
  <Target Name="PrecompileShadersRelease" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ReleaseShaderOutputDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)release-shaders</_ReleaseShaderOutputDir>
    </PropertyGroup>
    <Message Importance="high" Text="[Release Publish] Compiling shaders into $(_ReleaseShaderOutputDir)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)tools\Jatayu.Cooker\Jatayu.Cooker.csproj&quot; --configuration Release -- cook-shaders &quot;$(MSBuildThisFileDirectory)assets\shaders&quot; &quot;$(_ReleaseShaderOutputDir)&quot;" />
    <ItemGroup>
      <_ReleaseShader Include="$(_ReleaseShaderOutputDir)\*.spv" />
    </ItemGroup>
    <Error Condition="'@(_ReleaseShader)' == ''" Text="Release shader compilation produced no SPIR-V files." />
    <Copy SourceFiles="@(_ReleaseShader)" DestinationFolder="$(PublishDir)assets\shaders" />
  </Target>

</Project>
