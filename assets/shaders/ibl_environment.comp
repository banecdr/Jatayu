#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) writeonly uniform image2DArray outEnvironment;

vec3 CubeDirection(vec2 uv, uint face) {
    vec2 st = uv * 2.0 - 1.0;
    vec3 dir = vec3(0.0);
    switch (face) {
        case 0: dir = vec3( 1.0, -st.y, -st.x); break;
        case 1: dir = vec3(-1.0, -st.y,  st.x); break;
        case 2: dir = vec3( st.x,  1.0,  st.y); break;
        case 3: dir = vec3( st.x, -1.0, -st.y); break;
        case 4: dir = vec3( st.x, -st.y,  1.0); break;
        case 5: dir = vec3(-st.x, -st.y, -1.0); break;
    }
    return normalize(dir);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(outEnvironment);
    if (coord.x >= size.x || coord.y >= size.y || coord.z >= 6) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(size.xy);
    vec3 direction = CubeDirection(uv, uint(coord.z));
    float horizon = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 sky = mix(vec3(0.32, 0.27, 0.22), vec3(0.10, 0.28, 0.62), pow(horizon, 0.65));
    vec3 ground = vec3(0.12, 0.095, 0.065);
    vec3 color = direction.y >= 0.0 ? sky : mix(ground, sky, horizon * 0.15);

    vec3 sunDirection = normalize(vec3(-0.45, 0.82, -0.35));
    float sun = smoothstep(0.99955, 0.99985, dot(direction, sunDirection));
    color += vec3(18.0, 14.0, 8.0) * sun;
    imageStore(outEnvironment, coord, vec4(color, 1.0));
}
