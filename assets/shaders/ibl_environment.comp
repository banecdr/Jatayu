#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) writeonly uniform image2DArray outEnvironment;

const vec3 ZenithColor = vec3(0.12, 0.32, 0.72);
const vec3 HorizonColor = vec3(0.70, 0.82, 0.95);
const vec3 GroundColor = vec3(0.18, 0.16, 0.14);

vec3 CubeDirection(vec2 uv, uint face) {
    vec2 st = uv * 2.0 - 1.0;
    vec3 dir = vec3(0.0);
    switch (face) {
        case 0: dir = vec3( 1.0, -st.y, -st.x); break;
        case 1: dir = vec3(-1.0, -st.y,  st.x); break;
        case 2: dir = vec3( st.x,  1.0,  st.y); break;
        case 3: dir = vec3( st.x, -1.0, -st.y); break;
        case 4: dir = vec3( st.x, -st.y,  1.0); break;
        case 5: dir = vec3(-st.x, -st.y, -1.0); break;
    }
    return normalize(dir);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(outEnvironment);
    if (coord.x >= size.x || coord.y >= size.y || coord.z >= 6) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(size.xy);
    vec3 dir = CubeDirection(uv, uint(coord.z));

    vec3 color;
    if (dir.y >= 0.0) {
        // Sky hemisphere: blend horizon to zenith matching skybox.frag
        float t = pow(dir.y, 0.6);
        color = mix(HorizonColor, ZenithColor, t);
    } else {
        // Ground hemisphere: blend horizon to ground matching skybox.frag
        float t = pow(-dir.y, 0.7);
        color = mix(HorizonColor, GroundColor, t);
    }

    // Direct Cook-Torrance specular in pbr.frag handles the sun highlight dynamically;
    // no static secondary sun disc baked into the ambient reflection probe.
    imageStore(outEnvironment, coord, vec4(color, 1.0));
}
