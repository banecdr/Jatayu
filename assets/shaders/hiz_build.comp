#version 450

// ==================================================================================================
// Jatayu Engine - Hi-Z Depth Pyramid Construction
// Shader: hiz_build.comp
// Role: Downsamples depth using MIN reduction for Reverse-Z hierarchical occlusion culling (Sprint 7a).
// ==================================================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D u_SourceDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_DestHiZ;

layout(push_constant) uniform PushConstants {
    uvec2 PrevLevelDim;
    uvec2 DestDim;
} u_Push;

void main() {
    uvec2 destCoords = gl_GlobalInvocationID.xy;
    if (destCoords.x >= u_Push.DestDim.x || destCoords.y >= u_Push.DestDim.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(u_Push.PrevLevelDim);
    vec2 baseUv = vec2(destCoords * 2) * texelSize;

    // Sample 4 footprint taps covering the 2x2 source footprint
    float d0 = textureLod(u_SourceDepth, baseUv + vec2(0.25, 0.25) * texelSize * 2.0, 0.0).r;
    float d1 = textureLod(u_SourceDepth, baseUv + vec2(0.75, 0.25) * texelSize * 2.0, 0.0).r;
    float d2 = textureLod(u_SourceDepth, baseUv + vec2(0.25, 0.75) * texelSize * 2.0, 0.0).r;
    float d3 = textureLod(u_SourceDepth, baseUv + vec2(0.75, 0.75) * texelSize * 2.0, 0.0).r;

    // In Reverse-Z, min depth is the furthest surface
    float minDepth = min(min(d0, d1), min(d2, d3));

    imageStore(u_DestHiZ, ivec2(destCoords), vec4(minDepth, 0.0, 0.0, 0.0));
}
